    "_postman_id": "f7aad2dc-e3b0-4cf5-9d3c-2d941c2a68b3",
    "name": "Rybbit Analytics Sessions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Rybbit is an open-source, privacy-friendly web and product analytics platform. This specification covers the public event ingestion endpoint (POST /api/track) used by the tracking script and server-side integrations, and the Bearer-key-authenticated Stats API (beta) for querying sites, sessions, users, retention, and events. The cloud base URL is https://app.rybbit.io; self-hosted instances expose the same paths on their own domain.\n\nContact Support:\n Name: Rybbit",
      "type": "text/plain"
    }
  }
