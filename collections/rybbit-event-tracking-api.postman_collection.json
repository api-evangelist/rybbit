              "raw": "{\n  \"site_id\": \"<string>\",\n  \"type\": \"<string>\",\n  \"event_name\": \"<string>\",\n  \"hostname\": \"<string>\",\n  \"pathname\": \"<string>\",\n  \"querystring\": \"<string>\",\n  \"page_title\": \"<string>\",\n  \"referrer\": \"<string>\",\n  \"language\": \"<string>\",\n  \"screenWidth\": \"<integer>\",\n  \"screenHeight\": \"<integer>\",\n  \"user_agent\": \"<string>\",\n  \"properties\": \"<string>\"\n}",
